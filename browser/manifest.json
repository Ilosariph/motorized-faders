{
  "manifest_version": 2,
  "name": "Motorized Faders media speed",
  "version": "0.2.0",
  "description": "Lets the motorized faders set the playback speed of videos and audio on web pages (YouTube, Spotify, Jellyfin ...). Talks to the faders host and the AgentDeck daemon on 127.0.0.1 only.",
  "homepage_url": "https://github.com/Ilosariph/motorized-faders",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-speed@motorized-faders",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
